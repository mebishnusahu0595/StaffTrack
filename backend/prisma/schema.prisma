generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String            @id @default(cuid())
  name             String
  createdAt        DateTime          @default(now())
  companyFiles     CompanyFile[]
  dailyAllowances  DailyAllowance[]
  dealers          Dealer[]
  forms            Form[]
  groups           Group[]
  holidays         Holiday[]
  holidayTemplates HolidayTemplate[]
  issues           Issue[]
  leaveRequests    LeaveRequest[]
  leaveTypes       LeaveType[]
  projects         Project[]
  salarySlips      SalarySlip[]
  syncDevices      SyncDevice[]
  users            User[]
}

model Group {
  id         String   @id @default(cuid())
  name       String
  baseSalary Float    @default(0)
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members    User[]

  @@index([companyId])
}

model User {
  id                  String               @id @default(cuid())
  name                String
  email               String               @unique
  passwordHash        String
  phone               String
  role                UserRole
  workMode            WorkMode             @default(BOTH)
  designation         String?
  joiningDate         DateTime             @default(now())
  avatarUrl           String?
  shiftStart          String               @default("09:00")
  shiftEnd            String               @default("18:00")
  baseSalary          Float                @default(0)
  companyId           String
  managerId           String?
  groupId             String?
  employeeCode        String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  holidayTemplateId   String?
  batteryLevel        Int?
  expoPushToken       String?
  isLocationOn        Boolean              @default(true)
  locationOffAt       DateTime?
  travelRate          Float                @default(5.0)
  attendances         Attendance[]
  attendanceRequests  AttendanceRequest[]
  uploadedFiles       CompanyFile[]
  dailyAllowances     DailyAllowance[]
  dayEndReports       DayEndReport[]
  approvedExpenses    Expense[]            @relation("ExpenseApprover")
  expenses            Expense[]            @relation("ExpenseOwner")
  createdForms        Form[]               @relation("CreatedForms")
  formResponses       FormResponse[]
  assignedIssues      Issue[]              @relation("AssignedIssues")
  reportedIssues      Issue[]              @relation("ReportedIssues")
  issueUpdates        IssueUpdate[]
  approvedLeaves      LeaveRequest[]       @relation("ApprovedLeaves")
  leaveRequests       LeaveRequest[]       @relation("UserLeaves")
  locationLogs        LocationLog[]
  notifications       Notification[]
  projectAssignments  ProjectAssignment[]
  projectProgressLogs ProjectProgressLog[]
  salarySlips         SalarySlip[]         @relation("UserSalarySlips")
  createdTasks        Task[]               @relation("CreatedTasks")
  assignedTasks       Task[]               @relation("AssignedTasks")
  createdTemplates    Template[]           @relation("CreatedTemplates")
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group               Group?               @relation(fields: [groupId], references: [id])
  holidayTemplate     HolidayTemplate?     @relation(fields: [holidayTemplateId], references: [id])
  manager             User?                @relation("ManagerTeam", fields: [managerId], references: [id])
  teamMembers         User[]               @relation("ManagerTeam")

  @@index([companyId])
  @@index([managerId])
  @@index([groupId])
}

model Holiday {
  id          String   @id @default(cuid())
  date        DateTime
  name        String
  description String?
  type        String   @default("HOLIDAY")
  companyId   String
  groupId     String?
  userId      String?
  createdAt   DateTime @default(now())
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([groupId])
  @@index([userId])
}

model Task {
  id                 String     @id @default(cuid())
  title              String
  description        String?
  status             TaskStatus @default(PENDING)
  assignedToId       String
  assignedById       String
  dueDate            DateTime
  lat                Float?
  lng                Float?
  isRepeating        Boolean    @default(false)
  repeatFrequency    String?
  repeatDays         String?
  repeatDates        String?
  skipHolidays       Boolean    @default(false)
  completionPhotoUrl String?
  completionRemarks  String?
  projectId          String?
  priority           String     @default("Medium")
  points             Int        @default(0)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  attachmentName     String?
  attachmentUrl      String?
  checklist          Json?
  checklistResponses Json?
  completionLat      Float?
  completionLng      Float?
  endDate            DateTime?
  geofenceLat        Float?
  geofenceLng        Float?
  geofenceRadius     Float?
  isSubtask          Boolean    @default(false)
  parentTaskId       String?
  reminder           Int?
  startDate          DateTime?
  templateId         String?
  validations        Json?
  completedAt        DateTime?
  taskType           String     @default("NORMAL")
  assignedBy         User       @relation("CreatedTasks", fields: [assignedById], references: [id], onDelete: Cascade)
  assignedTo         User       @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  parentTask         Task?      @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]     @relation("SubTasks")
  project            Project?   @relation(fields: [projectId], references: [id])
  template           Template?  @relation(fields: [templateId], references: [id])
  dealers            Dealer[]   @relation("TaskDealers")

  @@index([assignedToId])
  @@index([assignedById])
  @@index([status])
  @@index([templateId])
}

model LocationLog {
  id           String   @id @default(cuid())
  userId       String
  lat          Float
  lng          Float
  accuracy     Float
  batteryLevel Float?
  timestamp    DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
}

model Attendance {
  id                    String           @id @default(cuid())
  userId                String
  date                  DateTime
  punchType             PunchType?
  checkInTime           DateTime?
  checkInLat            Float?
  checkInLng            Float?
  checkInPhotoUrl       String?
  checkOutTime          DateTime?
  checkOutLat           Float?
  checkOutLng           Float?
  checkOutPhotoUrl      String?
  status                AttendanceStatus @default(PRESENT)
  checkInApproved       Boolean          @default(true)
  checkInApprovedAt     DateTime?
  checkInApprovedBy     String?
  endOdometer           Float?
  endOdometerPhotoUrl   String?
  isCheckInPending      Boolean          @default(false)
  startOdometer         Float?
  startOdometerPhotoUrl String?
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  breaks                Break[]
  checkInAiAnalysis     Json?
  checkOutAiAnalysis    Json?

  @@index([userId, date])
}

model DayEndReport {
  id                    String   @id @default(cuid())
  userId                String
  date                  DateTime
  visitsSummary         String
  ordersTaken           Int
  ordersCancelled       Int
  kmTravelled           Float
  kmPhotoUrl            String?
  startOdometer         Float?
  endOdometer           Float?
  startOdometerPhotoUrl String?
  remarks               String
  submittedAt           DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Expense {
  id           String          @id @default(cuid())
  userId       String
  category     ExpenseCategory
  amount       Float
  description  String
  receiptUrl   String
  date         DateTime
  approved     Boolean         @default(false)
  approvedById String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  approvedBy   User?           @relation("ExpenseApprover", fields: [approvedById], references: [id])
  user         User            @relation("ExpenseOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([approvedById])
}

model Project {
  id             String              @id @default(cuid())
  name           String
  description    String?
  status         String              @default("Ongoing")
  companyId      String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  employeeBudget Float?
  expenseBudget  Float?
  targetClients  Int?
  budget         Float?
  clientName     String?
  deadline       DateTime?
  department     String?
  endDate        DateTime?
  objectives     String?
  priority       String              @default("Medium")
  startDate      DateTime?
  tags           String?
  targetQuantity Int                 @default(0)
  targetType     String              @default("YEARLY")
  productName    String?
  productPrice   Float?              @default(0)
  issues         Issue[]
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignments    ProjectAssignment[]
  tasks          Task[]

  @@index([companyId])
}

model ProjectAssignment {
  id             String                  @id @default(cuid())
  projectId      String
  userId         String
  targetQuantity Int                     @default(0)
  completedCount Int                     @default(0)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  project        Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  periods        ProjectPeriodProgress[]

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model ProjectPeriodProgress {
  id              String               @id @default(cuid())
  assignmentId    String
  periodType      String
  periodIndex     Int
  periodName      String
  startDate       DateTime
  endDate         DateTime
  baseTarget      Int                  @default(0)
  carryover       Int                  @default(0)
  effectiveTarget Int                  @default(0)
  completedCount  Int                  @default(0)
  isCompleted     Boolean              @default(false)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  assignment      ProjectAssignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  logs            ProjectProgressLog[]

  @@index([assignmentId])
}

model Issue {
  id           String        @id @default(cuid())
  title        String
  description  String
  priority     String        @default("Medium")
  status       String        @default("Open")
  startDate    DateTime      @default(now())
  reportedById String
  assigneeId   String?
  companyId    String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  category     String        @default("General")
  department   String?
  projectId    String?
  assignee     User?         @relation("AssignedIssues", fields: [assigneeId], references: [id])
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project      Project?      @relation(fields: [projectId], references: [id])
  reportedBy   User          @relation("ReportedIssues", fields: [reportedById], references: [id], onDelete: Cascade)
  updates      IssueUpdate[]

  @@index([companyId])
  @@index([reportedById])
}

model IssueUpdate {
  id        String   @id @default(cuid())
  issueId   String
  userId    String
  type      String
  content   String?
  createdAt DateTime @default(now())
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

model Form {
  id          String         @id @default(cuid())
  name        String
  category    String?
  status      String         @default("Published")
  createdById String?
  companyId   String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   User?          @relation("CreatedForms", fields: [createdById], references: [id])
  fields      FormField[]
  responses   FormResponse[]

  @@index([companyId])
}

model FormField {
  id       String  @id @default(cuid())
  formId   String
  label    String
  type     String
  required Boolean @default(false)
  options  String?
  form     Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
}

model FormResponse {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  data        String
  submittedAt DateTime @default(now())
  form        Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

model Template {
  id          String   @id @default(cuid())
  name        String
  type        String
  priority    String   @default("Medium")
  startTime   String?
  dueTime     String?
  recurrence  String?
  description String?
  data        String   @default("{}")
  rating      Float    @default(0)
  usageCount  Int      @default(0)
  createdById String?
  companyId   String?
  createdAt   DateTime @default(now())
  tasks       Task[]
  createdBy   User?    @relation("CreatedTemplates", fields: [createdById], references: [id])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Break {
  id           String     @id @default(cuid())
  attendanceId String
  startTime    DateTime   @default(now())
  endTime      DateTime?
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
}

model LeaveRequest {
  id           String      @id @default(cuid())
  userId       String
  startDate    DateTime
  endDate      DateTime
  reason       String
  status       LeaveStatus @default(PENDING)
  approvedById String?
  companyId    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  approvedBy   User?       @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  company      Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user         User        @relation("UserLeaves", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model AttendanceRequest {
  id           String        @id @default(cuid())
  userId       String
  date         DateTime
  type         String        @default("New Punch Added")
  punchType    PunchType     @default(OFFICE)
  checkInTime  DateTime?
  checkOutTime DateTime?
  reason       String
  status       RequestStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model SyncDevice {
  id         String   @id @default(cuid())
  name       String
  macAddress String   @unique
  lastSync   DateTime
  status     String   @default("Offline")
  companyId  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LeaveType {
  id                  String   @id @default(cuid())
  name                String
  alias               String
  description         String?
  autoAllocationCount Float
  autoAllocationFreq  String
  carryForward        Float
  carryForwardFreq    String
  encashment          Boolean  @default(false)
  leaveCycle          String   @default("CALENDAR")
  companyId           String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model HolidayTemplate {
  id        String                @id @default(cuid())
  name      String
  companyId String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  holidays  HolidayTemplateItem[]
  users     User[]

  @@index([companyId])
}

model HolidayTemplateItem {
  id          String          @id @default(cuid())
  templateId  String
  date        DateTime
  name        String
  description String?
  createdAt   DateTime        @default(now())
  template    HolidayTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model SalarySlip {
  id             String           @id @default(cuid())
  userId         String
  companyId      String
  month          Int
  year           Int
  status         SalarySlipStatus @default(DRAFT)
  orgName        String?
  orgSubtitle    String?
  orgCode        String?
  logoUrl        String?
  orgEmail       String?
  orgWebsite     String?
  orgPhone       String?
  companyCode    String?
  bankName       String?
  bankAccountNo  String?
  ifscCode       String?
  departmentName String?
  divisionName   String?
  designation    String?
  traineeType    String?
  aadhaarNumber  String?
  monthDays      Float?
  payableDays    Float?
  earnings       Json?
  deductions     Json?
  netPay         Float            @default(0)
  netPayWords    String?
  remarks        String?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User             @relation("UserSalarySlips", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@index([companyId])
  @@index([userId])
}

model CompanyFile {
  id           String   @id @default(cuid())
  title        String
  description  String?
  fileUrl      String
  fileName     String
  fileSize     Float?
  fileType     String?
  mimeType     String?
  category     String?  @default("General")
  uploadedById String
  companyId    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([uploadedById])
}

model Dealer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  city      String?
  state     String?
  pincode   String?
  gstin     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks     Task[]   @relation("TaskDealers")

  @@index([companyId])
}

model DailyAllowance {
  id        String   @id @default(cuid())
  userId    String
  companyId String
  date      DateTime
  amount    Float
  remark    String?
  gpsKm     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([companyId, date])
  @@index([userId, date])
}

model ProjectProgressLog {
  id            String                @id @default(cuid())
  periodId      String
  changedBy     String
  previousCount Int
  newCount      Int
  delta         Int
  note          String?
  createdAt     DateTime              @default(now())
  user          User                  @relation(fields: [changedBy], references: [id], onDelete: Cascade)
  period        ProjectPeriodProgress @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([changedBy])
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ExpenseCategory {
  TRAVEL
  FOOD
  ACCOMMODATION
  OTHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  ON_LEAVE
}

enum PunchType {
  OFFICE
  FIELD
}

enum WorkMode {
  OFFICE
  FIELD
  BOTH
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SalarySlipStatus {
  DRAFT
  PUBLISHED
}
